{
  "mcpServers": {
    "monday": {
      "command": "npx",
      "args": ["-y", "@mondaydotcomorg/monday-api-mcp"],
      "env": {
        "MONDAY_API_TOKEN": "${MONDAY_API_TOKEN}"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(sdlc *)",
      "Bash(cai *)",
      "mcp__monday__*"
    ]
  }
}
